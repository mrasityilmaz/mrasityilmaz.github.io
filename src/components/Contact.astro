---
import { site, mailto } from '../data/site';
---

<section class="contact section cv-auto" id="contact" aria-labelledby="contact-title">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container contact__inner">
    <p class="eyebrow" data-reveal>Contact</p>
    <h2 id="contact-title" class="contact__title" data-reveal style="--d: 80ms">
      Have an app in mind?<br />
      <span class="serif">Let’s build it.</span>
    </h2>
    <p class="contact__lead" data-reveal style="--d: 160ms">
      Freelance projects, full-time roles or just a question about Flutter — my inbox is open. I usually reply within a day or two.
    </p>

    <div class="contact__mail" data-reveal style="--d: 240ms">
      <a class="contact__address" href={mailto('Hello Raşit')}>
        <span>{site.email}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M8.5 6H18v9.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <button class="btn btn--ghost contact__copy" type="button" data-copy={site.email}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M10.5 3.2A1.7 1.7 0 0 0 9 2.5H4.2A1.7 1.7 0 0 0 2.5 4.2V9c0 .6.3 1.2.8 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
        <span data-copy-label>Copy email</span>
      </button>
    </div>

    <ul class="contact__links" data-reveal style="--d: 320ms">
      <li>
        <a href={site.social.linkedin} target="_blank" rel="noopener">
          <span>LinkedIn</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </li>
      <li>
        <a href={site.social.github} target="_blank" rel="noopener">
          <span>GitHub</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </li>
      <li class="contact__loc">
        <span>Based in {site.location}</span>
      </li>
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Press ⌘C';
      }
      setTimeout(() => label && (label.textContent = original), 1800);
    });
  });
</script>

<style>
  .contact {
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .contact__glow {
    position: absolute;
    left: 50%;
    bottom: -40%;
    width: min(1200px, 140vw);
    aspect-ratio: 2 / 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(124 108 242 / 0.28), transparent 70%);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .contact__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 28px;
  }

  .contact__title {
    font-size: var(--fs-3xl);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .contact__title .serif {
    color: var(--accent);
  }

  .contact__lead {
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--fs-md);
  }

  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }

  .contact__address {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: -0.035em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size 0.6s var(--ease-out);
    overflow-wrap: anywhere;
  }

  .contact__address:hover {
    background-size: 100% 1.5px;
  }

  .contact__address svg {
    width: 0.8em;
    height: 0.8em;
    flex: none;
    transition: transform 0.5s var(--ease-out);
  }

  .contact__address:hover svg {
    transform: translate(3px, -3px);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin-top: 12px;
    list-style: none;
  }

  .contact__links a,
  .contact__loc span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding-inline: 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--text-2);
    font-size: var(--fs-sm);
    transition:
      color 0.25s,
      background-color 0.25s;
  }

  .contact__links a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }

  .contact__links svg {
    width: 13px;
    height: 13px;
  }

  .contact__loc span {
    box-shadow: none;
    padding-inline: 4px;
  }
</style>
