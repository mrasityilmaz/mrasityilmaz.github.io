---
import { Image } from 'astro:assets';
import portrait from '../assets/me/portrait.webp';
import { site, mailto } from '../data/site';
import { apps, clients } from '../data/apps';
import AppIcon from './AppIcon.astro';

// Icons that orbit the portrait — newest first, a handful is enough.
const orbit = apps.filter((a) => a.heroOrbit).slice(0, 7);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__aurora"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow" data-hero-in>
        <span class="hero__dot" aria-hidden="true"></span>
        {site.role} · {site.location}
      </p>

      <h1 id="hero-title" class="hero__title">
        <span class="hero__line"><span data-hero-line>From first pixel</span></span>
        <span class="hero__line"><span data-hero-line>to the <em class="serif">App Store.</em></span></span>
      </h1>

      <p class="hero__lead" data-hero-in>
        I’m Raşit — I design, build and ship mobile apps with Flutter: AI-powered consumer apps, live streaming, social
        and enterprise platforms, on iOS and Android.
      </p>

      <div class="hero__actions" data-hero-in>
        <a class="btn" href="#apps">
          See the apps
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a class="btn btn--ghost" href={mailto('Hello Raşit')}>{site.email}</a>
      </div>
    </div>

    <div class="hero__visual" data-hero-visual>
      <div class="hero__portrait" data-tilt>
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[420, 640, 864]}
          sizes="(max-width: 860px) 70vw, 440px"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__portrait-shade" aria-hidden="true"></div>
        <a class="hero__badge" href="/sepello/">
          <span class="hero__badge-dot" aria-hidden="true"></span>
          <span class="hero__badge-l">Now building <strong>Sepello</strong></span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>

      <ul class="hero__orbit" aria-label="Some of the apps I built">
        {
          orbit.map((app, i) => (
            <li class="hero__icon" style={`--i:${i}`} data-depth={(0.4 + (i % 3) * 0.3).toFixed(2)}>
              <a href={`#app-${app.id}`} title={app.name}>
                <AppIcon app={app} size={96} eager />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="hero__clients" data-hero-in>
    <p class="eyebrow hero__clients-label">Built for</p>
    <div class="hero__marquee" aria-label={`Companies I have built apps for: ${clients.join(', ')}`}>
      <div class="hero__marquee-track" aria-hidden="true">
        {[0, 1].map(() => clients.map((c) => <span>{c}</span>))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  const lines = document.querySelectorAll('[data-hero-line]');
  const fades = document.querySelectorAll('[data-hero-in]');
  const visual = document.querySelector<HTMLElement>('[data-hero-visual]');
  const icons = document.querySelectorAll<HTMLElement>('.hero__icon');

  if (!prefersReducedMotion()) {
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    tl.from(lines, { yPercent: 110, duration: 1.4, stagger: 0.09 }, 0.1)
      .from(fades, { y: 24, opacity: 0, duration: 1.2, stagger: 0.08 }, 0.35)
      .from(visual, { y: 40, opacity: 0, scale: 0.96, duration: 1.6 }, 0.2)
      .from(icons, { scale: 0.4, opacity: 0, duration: 1.2, stagger: 0.06, ease: 'back.out(1.6)' }, 0.7);

    // Gentle pointer parallax on the icons + tilt on the portrait.
    const portrait = document.querySelector<HTMLElement>('[data-tilt]');
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (fine && visual) {
      const setters = Array.from(icons).map((el) => ({
        x: gsap.quickTo(el, 'x', { duration: 1.2, ease: 'power3.out' }),
        y: gsap.quickTo(el, 'y', { duration: 1.2, ease: 'power3.out' }),
        d: Number(el.dataset.depth ?? 0.5),
      }));
      const rx = portrait && gsap.quickTo(portrait, 'rotationX', { duration: 1, ease: 'power3.out' });
      const ry = portrait && gsap.quickTo(portrait, 'rotationY', { duration: 1, ease: 'power3.out' });
      window.addEventListener('pointermove', (e) => {
        const nx = e.clientX / window.innerWidth - 0.5;
        const ny = e.clientY / window.innerHeight - 0.5;
        setters.forEach((s) => {
          s.x(nx * 36 * s.d);
          s.y(ny * 36 * s.d);
        });
        rx && rx(ny * -6);
        ry && ry(nx * 8);
      });
    }

    // Visual drifts up a little slower than the page.
    gsap.to(visual, {
      yPercent: -8,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(48px, 7vw, 88px);
    padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px));
    padding-bottom: clamp(32px, 5vw, 56px);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__aurora {
    position: absolute;
    top: -30%;
    right: -20%;
    width: 90vw;
    max-width: 1300px;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 40% 45%, rgb(124 108 242 / 0.32), transparent 70%),
      radial-gradient(closest-side at 70% 65%, rgb(245 177 76 / 0.12), transparent 70%);
    filter: blur(20px);
    animation: aurora 18s ease-in-out infinite alternate;
  }

  @keyframes aurora {
    to {
      transform: translate(-6%, 8%) rotate(18deg) scale(1.08);
    }
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 60% 40%, #000 20%, transparent 75%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .hero__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7ee2a8;
    box-shadow: 0 0 0 4px rgb(126 226 168 / 0.16);
  }

  .hero__title {
    font-size: clamp(3.1rem, 1.4rem + 6.6vw, 8.25rem);
    font-weight: 560;
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero__line > span {
    display: inline-block;
  }

  .hero__title em {
    font-size: 1.06em;
    color: var(--accent);
    padding-right: 0.06em;
  }

  .hero__lead {
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--fs-md);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Visual */
  .hero__visual {
    position: relative;
    justify-self: center;
    width: min(100%, 440px);
    perspective: 1200px;
  }

  .hero__portrait {
    position: relative;
    aspect-ratio: 864 / 1184;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: #111;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 40px 100px -30px rgb(0 0 0 / 0.8);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05);
  }

  .hero__portrait-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(9 9 10 / 0.85) 0%, rgb(9 9 10 / 0) 42%),
      radial-gradient(120% 80% at 50% 0%, transparent 60%, rgb(9 9 10 / 0.4));
  }

  .hero__badge {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 16px;
    background: rgb(20 20 22 / 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: var(--text-2);
    font-size: var(--fs-sm);
    transition: background-color 0.3s;
  }

  .hero__badge:hover {
    background: rgb(30 30 34 / 0.7);
  }

  .hero__badge strong {
    color: var(--text);
    font-weight: 560;
  }

  .hero__badge-l {
    flex: 1;
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #9b7bff;
    box-shadow: 0 0 0 4px rgb(155 123 255 / 0.2);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .hero__badge svg {
    width: 15px;
    height: 15px;
    color: var(--text);
    transition: transform 0.4s var(--ease-out);
  }

  .hero__badge:hover svg {
    transform: translateX(3px);
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 7px rgb(155 123 255 / 0.05);
    }
  }

  .hero__orbit {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .hero__icon {
    --size: clamp(52px, 6.4vw, 76px);
    position: absolute;
    width: var(--size);
    height: var(--size);
    pointer-events: auto;
    animation: bob 6s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.9s);
  }

  .hero__icon a {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.5s var(--ease-out);
  }

  .hero__icon a:hover {
    transform: scale(1.1) rotate(-4deg);
  }

  .hero__icon :global(.app-icon) {
    width: 100%;
    height: 100%;
  }

  /* Hand-placed orbit positions around the portrait */
  .hero__icon:nth-child(1) { top: 6%; left: -15%; }
  .hero__icon:nth-child(2) { top: -6%; right: 12%; --size: clamp(44px, 5vw, 60px); }
  .hero__icon:nth-child(3) { top: 30%; right: -13%; }
  .hero__icon:nth-child(4) { top: 46%; left: -18%; --size: clamp(44px, 5vw, 62px); }
  .hero__icon:nth-child(5) { bottom: 24%; right: -16%; --size: clamp(46px, 5.2vw, 64px); }
  .hero__icon:nth-child(6) { bottom: -5%; left: 8%; --size: clamp(44px, 5vw, 60px); }
  .hero__icon:nth-child(7) { bottom: -8%; right: 18%; --size: clamp(40px, 4.4vw, 54px); }

  @keyframes bob {
    from {
      translate: 0 -6px;
    }
    to {
      translate: 0 6px;
    }
  }

  /* Clients marquee */
  .hero__clients {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: 22px var(--gutter) 0;
    border-top: 1px solid var(--line);
  }

  .hero__clients-label {
    flex: none;
  }

  .hero__marquee {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .hero__marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .hero__marquee-track span {
    padding-inline: 28px;
    color: var(--text-2);
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.35rem);
    font-weight: 520;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .hero__marquee-track span::after {
    content: '✦';
    margin-left: 56px;
    color: var(--text-3);
    font-size: 0.6em;
    vertical-align: middle;
  }

  .hero__marquee:hover .hero__marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      width: min(76%, 380px);
      margin-top: 16px;
    }

    .hero__clients {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .hero__marquee {
      width: 100%;
    }
  }
</style>
