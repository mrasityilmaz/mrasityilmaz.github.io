---
import { site, mailto } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__mark" aria-hidden="true">RY</span>
      <div>
        <p class="footer__name">{site.name}</p>
        <p class="footer__role">{site.role} · {site.location}</p>
      </div>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <a href="/#apps">Apps</a>
      <a href="/#experience">Experience</a>
      <a href="/#open-source">Open source</a>
      <a href="/sepello/">Sepello</a>
      <a href={mailto()}>Email</a>
      <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.social.github} target="_blank" rel="noopener">GitHub</a>
    </nav>

    <p class="footer__legal">© {year} {site.name}. App names, icons and screenshots belong to their respective owners.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 48px 40px;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px 48px;
    align-items: center;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    background: var(--invert-bg);
    color: var(--invert-text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .footer__name {
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .footer__role {
    color: var(--text-3);
    font-size: var(--fs-sm);
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  .footer__nav a {
    transition: color 0.25s;
  }

  .footer__nav a:hover {
    color: var(--text);
  }

  .footer__legal {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: var(--fs-xs);
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
