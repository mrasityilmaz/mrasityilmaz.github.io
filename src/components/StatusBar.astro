---
/** Minimal iOS status bar, sized relative to the enclosing .phone (cqw units). */
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<div class:list={['sb', `sb--${tone}`]} aria-hidden="true">
  <span class="sb__time">9:41</span>
  <span class="sb__glyphs">
    <svg viewBox="0 0 18 12">
      <rect x="0" y="8" width="3" height="4" rx="1"></rect>
      <rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect>
      <rect x="10" y="3" width="3" height="9" rx="1"></rect>
      <rect x="15" y="0" width="3" height="12" rx="1"></rect>
    </svg>
    <svg viewBox="0 0 16 12">
      <path d="M8 2.6c2.3 0 4.4.9 6 2.4l1.2-1.3A10.4 10.4 0 0 0 8 .8 10.4 10.4 0 0 0 .8 3.7L2 5c1.6-1.5 3.7-2.4 6-2.4Zm0 3.6c1.3 0 2.5.5 3.4 1.3l1.3-1.3A6.6 6.6 0 0 0 8 4.4c-1.8 0-3.4.7-4.7 1.8l1.3 1.3C5.5 6.7 6.7 6.2 8 6.2Zm0 3.6c-.5 0-1 .2-1.3.5L8 11.6l1.3-1.3c-.3-.3-.8-.5-1.3-.5Z"></path>
    </svg>
    <svg viewBox="0 0 27 12">
      <rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity=".4"></rect>
      <rect x="2" y="2" width="18" height="8" rx="2"></rect>
      <path d="M25 4v4c.8-.3 1.3-1.1 1.3-2S25.8 4.3 25 4Z" opacity=".45"></path>
    </svg>
  </span>
</div>

<style>
  .sb {
    position: absolute;
    z-index: 18;
    top: 0;
    left: 0;
    right: 0;
    height: 13.5cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4cqw 7.5cqw 0 9.5cqw;
    color: #fff;
    pointer-events: none;
  }

  .sb--light {
    color: #0b0b0c;
  }

  .sb__time {
    font-size: 4.1cqw;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .sb__glyphs {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
  }

  .sb__glyphs svg {
    height: 2.9cqw;
    width: auto;
    fill: currentColor;
  }
</style>
